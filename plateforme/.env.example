# Copier ce fichier en .env puis adapter. Ne jamais publier le fichier .env.

# Base PostgreSQL (Neon). La première sert aux migrations, la seconde (« pooler ») à l'application.
DATABASE_URL="postgresql://utilisateur:motdepasse@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full"
DATABASE_URL_POOLED="postgresql://utilisateur:motdepasse@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full"

# Secret des sessions : 64 caractères aléatoires.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="changer-par-une-valeur-aleatoire-de-64-caracteres"

# Facultatif : dossier des fichiers de livres (par défaut : plateforme/storage).
# STORAGE_DIR=

# Vidéo (Mux). Sans ces clés, seules les vidéos de démonstration (.mp4) et les vidéos Mux à lecture publique fonctionnent.
# Token d'accès API (Mux > Settings > Access Tokens) : nécessaire côté serveur pour créer un asset ou un
# upload, lister les vidéos et ajouter des pistes de sous-titres. Auth HTTP Basic (id + secret).
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=
# Mux > Settings > Signing Keys > Generate new key : identifiant de la clé et clé privée (base64, affichée une seule fois).
# MUX_SIGNING_KEY_ID=
# MUX_SIGNING_PRIVATE_KEY=
# Ces memes cles servent aussi aux directs Mux Live : /admin/lives > source « Mux Live (HLS) ».
# L'ingerestion RTMP se fait chez Mux (OBS / camera) : Vercel heberge la page, pas le flux video.
# Un token d'accès ne remplace pas une clé de signature : l'un appelle l'API, l'autre protège la lecture.

# Paiement. Sans PAYMENT_PROVIDER, l'adaptateur de démonstration est utilisé : le parcours d'achat
# et d'abonnement va jusqu'à une page de paiement simulée (aucune somme réelle). Pour fermer cette
# page — le jour où un vrai prestataire est branché, ou avant de montrer le site — mettre :
# DEMO_PAYMENT_VISIBLE=false
# PAYMENT_PROVIDER=demo

# --- FedaPay (sandbox d'abord ; ne jamais mettre les clés dans Git) --------------------------------
# PAYMENT_PROVIDER=fedapay
# FEDAPAY_ENV=sandbox                 # ou live, uniquement après validation du compte
# FEDAPAY_SECRET_KEY=                # clé SECRÈTE du bon environnement, serveur uniquement
# FEDAPAY_PUBLIC_KEY=                # clé publique, utile si on passe à Checkout.js
# FEDAPAY_WEBHOOK_SECRET=            # Workbench > Webhooks > Click to reveal (wh_sandbox_…)
# CCC_SITE_URL=https://votre-site.vercel.app   # URL publique HTTPS du callback ; sinon VERCEL_URL
# En local, utiliser un tunnel HTTPS (ngrok, cloudflared) : FedaPay doit pouvoir joindre le webhook.
# Endpoint à déclarer : https://<domaine>/api/payments/fedapay/webhook
# Événements : transaction.approved, transaction.declined, transaction.canceled, transaction.refunded

# --- Barème des commissions (parts du NET, après frais réels du prestataire) ----------------------
# CCC_FEE_PPM=200                    # estimation 2 %, seulement si les frais réels sont inconnus
# CCC_WRITER_PPM=8000               # écrivain 80 %
# CCC_DIOCESE_PPM=1000              # diocèse 10 %
# CCC_SUB_DIOCESE_PPM=1000          # diocèse 10 % sur les abonnements
# La part plateforme n'est pas réglable : elle prend toujours le reste (10 % avec ce barème).

# --- Partenariats (lot 8) -------------------------------------------------------------------------
# Par defaut (absent ou false) : la demonstration reste ouverte, les inscriptions diocese/ecrivain
# sont libres, mais un code saisi est verifie et consomme. A activer au passage en production :
# tous les comptes diocese/ecrivain exigent alors un code a usage unique, et /ecrivain est reserve
# aux profils d'auteur APPROUVES (code consomme ou validation dans /admin/partenariats).
# PARTNER_CODE_REQUIRED=true
# Les codes sont emis depuis /admin/partenariats ; seul leur HMAC (cle = SESSION_SECRET) est stocke.
# Attention : changer SESSION_SECRET invalide tous les codes deja emis et toutes les sessions.

# Développement seulement : photos de démonstration (npm run db:covers).
# PEXELS_API_KEY=
