# Copier ce fichier en .env puis adapter. Ne jamais publier le fichier .env.

# Base PostgreSQL (Neon). La première sert aux migrations, la seconde (« pooler ») à l'application.
DATABASE_URL="postgresql://utilisateur:motdepasse@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full"
DATABASE_URL_POOLED="postgresql://utilisateur:motdepasse@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=verify-full"

# Secret des sessions : 64 caractères aléatoires.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="changer-par-une-valeur-aleatoire-de-64-caracteres"

# Facultatif : dossier des fichiers de livres (par défaut : plateforme/storage).
# STORAGE_DIR=

# Développement seulement : photos de démonstration (npm run db:covers).
# PEXELS_API_KEY=
