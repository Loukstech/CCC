// Schéma de base de données CCC — cahier des charges v1.0 (sections 4 à 17)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  SUPER_ADMIN
  EDITOR
  RIGHTS_MANAGER
  FINANCE
  SUPPORT
  ANALYST
}

enum WorkType {
  BOOK
  FILM
  DOCUMENTARY
}

enum WorkStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AccessMode {
  FREE
  PURCHASE
  SUBSCRIPTION
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

enum Plan {
  MONTHLY
  YEARLY
}

/** Rôle d'un administrateur de diocèse. Le périmètre est porté par la table DioceseAdmin. */
enum DioceseAdminRole {
  ADMIN
  VIEWER
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  phone        String?  @unique
  passwordHash String?
  name         String?
  country      String?
  locale       String   @default("fr")
  staffRole    StaffRole?
  disabledAt   DateTime?
  createdAt    DateTime @default(now())

  devices       Device[]
  orders        Order[]
  subscriptions Subscription[]
  progress      Progress[]
  favorites     Favorite[]
  bookmarks     Bookmark[]

  /// Paroisse choisie à l'inscription. Facultatif : les comptes antérieurs et le personnel n'en ont pas.
  parishId        String?
  parish          Parish?   @relation(fields: [parishId], references: [id], onDelete: SetNull)
  /// Horodatage du consentement explicite au partage avec le diocèse (case obligatoire à l'inscription).
  parishConsentAt DateTime?

  dioceseAdmins DioceseAdmin[]

  reviews Review[]
  comments Comment[]
  reports  Report[]
}

// Référentiel : un diocèse (par pays) regroupe des paroisses. Aucune paroisse n'est supprimée (voir mergedIntoId).
model Diocese {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  country   String // code ISO : BJ, TG, NG
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  parishes Parish[]
  admins   DioceseAdmin[]

  @@index([country, active])
}

model Parish {
  id        String   @id @default(cuid())
  dioceseId String
  diocese   Diocese  @relation(fields: [dioceseId], references: [id], onDelete: Restrict)
  name      String
  city      String?
  active    Boolean  @default(true)
  /// Paroisse de rattachement si celle-ci a été fusionnée. On ne supprime jamais une paroisse.
  mergedIntoId String?
  mergedInto   Parish?  @relation("ParishMerge", fields: [mergedIntoId], references: [id])
  mergedFrom   Parish[] @relation("ParishMerge")
  createdAt DateTime @default(now())

  users User[]

  @@unique([dioceseId, name])
  @@index([dioceseId, active])
}

// Administrateur d'un diocèse : le périmètre (dioceseId) est porté par la donnée, jamais par l'URL.
model DioceseAdmin {
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  dioceseId String
  diocese   Diocese @relation(fields: [dioceseId], references: [id], onDelete: Cascade)
  role      DioceseAdminRole @default(ADMIN)
  createdAt DateTime @default(now())

  @@id([userId, dioceseId])
}

// Appareil autorisé (section 13)
model Device {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  platform   String
  keyHash    String    @unique
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Work {
  id          String     @id @default(cuid())
  type        WorkType
  slug        String     @unique
  title       String
  author      String?
  description String?
  coverUrl    String?
  language    String     @default("fr")
  status      WorkStatus @default(DRAFT)
  access      AccessMode
  downloadable Boolean    @default(false)
  fileKey     String? // clé du fichier du livre dans le stockage privé (storage/books)
  durationMin Int?
  pages       Int?
  publishedAt DateTime?
  createdAt   DateTime   @default(now())

  prices    Price[]
  licenses  License[]
  orders    Order[]
  progress  Progress[]
  favorites Favorite[]
  bookmarks Bookmark[]
  reviews   Review[]
  comments  Comment[]

  /// Moyennes dénormalisées : recalculées à chaque changement de statut d'un avis ou d'un commentaire.
  ratingAvg    Float @default(0)
  ratingCount  Int   @default(0)
  commentCount Int   @default(0)

  @@index([type, status])
}

// Prix par pays (section 11)
model Price {
  id       String @id @default(cuid())
  workId   String
  work     Work   @relation(fields: [workId], references: [id], onDelete: Cascade)
  country  String
  currency String
  amount   Int // plus petite unité de la devise

  @@unique([workId, country])
}

// Registre des licences par œuvre et territoire (section 17)
model License {
  id          String    @id @default(cuid())
  workId      String
  work        Work      @relation(fields: [workId], references: [id], onDelete: Cascade)
  countries   String[] // codes pays ISO ; vide = aucun pays autorisé
  allowWeb    Boolean   @default(true)
  allowMobile Boolean   @default(true)
  allowOffline Boolean  @default(false)
  startsAt    DateTime?
  endsAt      DateTime?
  contractRef String?
  createdAt   DateTime  @default(now())

  @@index([workId])
}

model Order {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  workId    String? // vide pour une commande d'abonnement
  work      Work?       @relation(fields: [workId], references: [id], onDelete: Restrict)
  plan      Plan? // renseigné pour une commande d'abonnement
  status    OrderStatus @default(PENDING)
  currency  String
  amount    Int
  provider  String?
  providerRef String?
  createdAt DateTime    @default(now())
  paidAt    DateTime?

  @@index([userId])
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id])
  plan      Plan
  status    SubscriptionStatus @default(ACTIVE)
  startsAt  DateTime           @default(now())
  endsAt    DateTime
  renewsAt  DateTime?
  provider  String?

  @@index([userId, status])
}

model Progress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workId    String
  work      Work     @relation(fields: [workId], references: [id])
  position  Float // page ou seconde
  locator   String? // repère exact de lecture (EPUB : CFI)
  updatedAt DateTime @updatedAt

  @@unique([userId, workId])
}

model Favorite {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workId String
  work   Work   @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@id([userId, workId])
}

// Signet de lecture (section 9, L-06) : une position précise dans un livre
model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workId    String
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  locator   String // repère exact (EPUB : CFI)
  label     String?
  percent   Float    @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, workId, locator])
  @@index([userId, workId])
}

// Prix des abonnements par pays (section 11) ; le montant est dans la plus petite unité de la devise
model PlanPrice {
  id       String @id @default(cuid())
  plan     Plan
  country  String
  currency String
  amount   Int

  @@unique([plan, country])
}

// Emplacements publicitaires (bandeaux). Les publicités sont gérées dans l'administration.
enum AdPlacement {
  HOME // bandeau de la page d'accueil
  CATALOG // bandeau des pages Livres, Documentaires et Films
  WORK // bandeau de la fiche d'une œuvre
  STICKY // bandeau fixe en bas de l'écran, que l'on peut fermer
}

model Ad {
  id         String      @id @default(cuid())
  placement  AdPlacement
  title      String
  advertiser String
  text       String?
  imageUrl   String?
  linkUrl    String
  active     Boolean     @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  clicks     Int         @default(0)
  createdAt  DateTime    @default(now())

  @@index([placement, active])
}

// Journal d'audit (sections 4.3 et 16)
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Avis et commentaires. Publication immédiate (réponse client) : la modération est a posteriori,
// déclenchée par un signalement ou par la file d'administration.
enum ContentStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

enum ReportTarget {
  REVIEW
  COMMENT
}

enum ReportStatus {
  OPEN
  HANDLED
  DISMISSED
}

// Un avis par personne et par œuvre, note obligatoire de 1 à 5.
model Review {
  id        String        @id @default(cuid())
  workId    String
  work      Work          @relation(fields: [workId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  body      String?
  status    ContentStatus @default(PUBLISHED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([userId, workId])
  @@index([workId, status])
}

model Comment {
  id        String        @id @default(cuid())
  workId    String
  work      Work          @relation(fields: [workId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  status    ContentStatus @default(PUBLISHED)
  /// Réponse à un autre commentaire : un seul niveau, pas d'arborescence profonde.
  parentId  String?
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentReplies")
  createdAt DateTime      @default(now())

  @@index([workId, status, createdAt])
}

// Signalement d'un avis ou d'un commentaire. La cible est polymorphe (pas de clé étrangère possible).
model Report {
  id         String       @id @default(cuid())
  targetType ReportTarget
  targetId   String
  reporterId String
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())

  @@unique([targetType, targetId, reporterId])
  @@index([status, createdAt])
}
