// Schéma de base de données CCC — cahier des charges v1.0 (sections 4 à 17)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum StaffRole {
  SUPER_ADMIN
  EDITOR
  RIGHTS_MANAGER
  FINANCE
  SUPPORT
  ANALYST
}

enum WorkType {
  BOOK
  FILM
  DOCUMENTARY
}

enum WorkStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AccessMode {
  FREE
  PURCHASE
  SUBSCRIPTION
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
}

enum Plan {
  MONTHLY
  YEARLY
}

/** Rôle d'un administrateur de diocèse. Le périmètre est porté par la table DioceseAdmin. */
enum DioceseAdminRole {
  ADMIN
  VIEWER
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  phone        String?  @unique
  passwordHash String?
  name         String?
  country      String?
  locale       String   @default("fr")
  staffRole    StaffRole?
  disabledAt   DateTime?
  createdAt    DateTime @default(now())

  devices       Device[]
  orders        Order[]
  subscriptions Subscription[]
  progress      Progress[]
  favorites     Favorite[]
  bookmarks     Bookmark[]

  /// Paroisse choisie à l'inscription. Facultatif : les comptes antérieurs et le personnel n'en ont pas.
  parishId        String?
  parish          Parish?   @relation(fields: [parishId], references: [id], onDelete: SetNull)
  /// Horodatage du consentement explicite au partage avec le diocèse (case obligatoire à l'inscription).
  parishConsentAt DateTime?

  dioceseAdmins DioceseAdmin[]

  reviews Review[]
  comments Comment[]
  reports  Report[]

  /// Œuvres dont ce compte est l'auteur ou le réalisateur (lot 6 : espace écrivain).
  works Work[] @relation("WorkAuthor")

  writerProfile WriterProfile?
  manuscripts   Manuscript[] @relation("ManuscriptAuthor")
  /// Écritures de commission dont ce compte est le bénéficiaire (écrivain).
  ledgerEntries CommissionEntry[] @relation("LedgerUser")
  payoutItems   PayoutItem[] @relation("PayoutUser")

  partnerCodesUsed    PartnerCode[]     @relation("PartnerCodeUsedBy")
  partnerCodesCreated PartnerCode[]     @relation("PartnerCodeCreatedBy")
  liveBadge           LiveBroadcaster?  @relation("LiveBadgeOwner")
  liveBadgesGranted   LiveBroadcaster[] @relation("LiveBadgeGrantedBy")
  liveEventsCreated   LiveEvent[]       @relation("LiveEventCreatedBy")
}

// Référentiel : un diocèse (par pays) regroupe des paroisses. Aucune paroisse n'est supprimée (voir mergedIntoId).
model Diocese {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  country   String // code ISO : BJ, TG, NG
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  parishes Parish[]
  admins   DioceseAdmin[]
  partnerCodes PartnerCode[]
  /// Part de revenus revenant à ce diocèse (lot 4).
  ledgerEntries CommissionEntry[] @relation("LedgerDiocese")
  payoutItems   PayoutItem[] @relation("PayoutDiocese")

  @@index([country, active])
}

model Parish {
  id        String   @id @default(cuid())
  dioceseId String
  diocese   Diocese  @relation(fields: [dioceseId], references: [id], onDelete: Restrict)
  name      String
  city      String?
  active    Boolean  @default(true)
  /// Paroisse de rattachement si celle-ci a été fusionnée. On ne supprime jamais une paroisse.
  mergedIntoId String?
  mergedInto   Parish?  @relation("ParishMerge", fields: [mergedIntoId], references: [id])
  mergedFrom   Parish[] @relation("ParishMerge")
  createdAt DateTime @default(now())

  users User[]

  @@unique([dioceseId, name])
  @@index([dioceseId, active])
}

// Administrateur d'un diocèse : le périmètre (dioceseId) est porté par la donnée, jamais par l'URL.
model DioceseAdmin {
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  dioceseId String
  diocese   Diocese @relation(fields: [dioceseId], references: [id], onDelete: Cascade)
  role      DioceseAdminRole @default(ADMIN)
  createdAt DateTime @default(now())

  @@id([userId, dioceseId])
}

// Appareil autorisé (section 13)
model Device {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  platform   String
  keyHash    String    @unique
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Work {
  id          String     @id @default(cuid())
  type        WorkType
  slug        String     @unique
  title       String
  author      String?
  /// Compte auteur/réalisateur. Le champ `author` reste le nom affiché : il survit à la suppression du compte.
  authorId    String?
  authorUser  User?      @relation("WorkAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  description String?
  coverUrl    String?
  language    String     @default("fr")
  status      WorkStatus @default(DRAFT)
  access      AccessMode
  downloadable Boolean    @default(false)
  fileKey     String? // clé du fichier du livre dans le stockage privé (storage/books)
  durationMin Int?
  pages       Int?
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  /// Identifiant commun aux éditions d'un même titre (la même œuvre en plusieurs langues).
  /// Vide : l'œuvre n'a pas de traduction connue. Plusieurs œuvres peuvent partager cette valeur.
  translationGroupId String?
  /// Édition de référence du groupe : c'est elle que le catalogue affiche, pour ne pas montrer
  /// trois fois le même titre. Les autres restent accessibles par leur adresse et par le sélecteur.
  translationPrimary Boolean @default(true)

  prices    Price[]
  licenses  License[]
  orders    Order[]
  progress  Progress[]
  favorites Favorite[]
  bookmarks Bookmark[]
  reviews   Review[]
  comments  Comment[]
  subtitles Subtitle[]

  /// Moyennes dénormalisées : recalculées à chaque changement de statut d'un avis ou d'un commentaire.
  ratingAvg    Float @default(0)
  ratingCount  Int   @default(0)
  commentCount Int   @default(0)

  /// Compteurs d'audience cumulés. Incrémentés par `lib/audience.ts` en même temps que le
  /// rollup journalier : lecture rapide sur les fiches sans parcourir tout l'historique.
  viewCount     Int @default(0)
  downloadCount Int @default(0)
  playCount     Int @default(0)

  audienceStats WorkAudienceStat[]

  @@index([type, status])
  @@index([authorId])
  @@index([translationGroupId])
}

/**
 * Rollup journalier des événements d'audience, une ligne par (œuvre, jour UTC).
 * On stocke des compteurs agrégés plutôt que chaque visite : les courbes de tendance restent
 * disponibles sur 12 mois sans table d'événements illimitée, et l'écriture reste un seul upsert.
 */
model WorkAudienceStat {
  id        String   @id @default(cuid())
  workId    String
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  day       DateTime @db.Date
  views     Int      @default(0)
  downloads Int      @default(0)
  plays     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workId, day])
  @@index([day])
}

// Sous-titres d'une vidéo (films et documentaires). Une piste par langue et par œuvre.
model Subtitle {
  id        String   @id @default(cuid())
  workId    String
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  /// Code langue court BCP-47 (« fr », « en ») : c'est lui que le navigateur compare.
  lang      String
  /// Libellé affiché dans le menu du lecteur (« Français », « English »).
  label     String
  /// Adresse du fichier WebVTT, servie telle quelle au navigateur.
  src       String
  /// Piste activée quand aucune ne correspond à la langue de l'interface.
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([workId, lang])
  @@index([workId])
}

// Prix par pays (section 11)
model Price {
  id       String @id @default(cuid())
  workId   String
  work     Work   @relation(fields: [workId], references: [id], onDelete: Cascade)
  country  String
  currency String
  amount   Int // plus petite unité de la devise

  @@unique([workId, country])
}

// Registre des licences par œuvre et territoire (section 17)
model License {
  id          String    @id @default(cuid())
  workId      String
  work        Work      @relation(fields: [workId], references: [id], onDelete: Cascade)
  countries   String[] // codes pays ISO ; vide = aucun pays autorisé
  allowWeb    Boolean   @default(true)
  allowMobile Boolean   @default(true)
  allowOffline Boolean  @default(false)
  startsAt    DateTime?
  endsAt      DateTime?
  contractRef String?
  createdAt   DateTime  @default(now())

  @@index([workId])
}

model Order {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  workId    String? // vide pour une commande d'abonnement
  work      Work?       @relation(fields: [workId], references: [id], onDelete: Restrict)
  plan      Plan? // renseigné pour une commande d'abonnement
  status    OrderStatus @default(PENDING)
  currency  String
  amount    Int // montant encaissé, frais du prestataire compris
  /// Frais du prestataire, en points de base de 10 000 (200 = 2 %). Tracés pour ne jamais les oublier.
  feePpm    Int         @default(0)
  /// Frais du prestataire en plus petite unité de la devise.
  feeAmount Int         @default(0)
  /// Net réellement reçu : amount - feeAmount. C'est la base des commissions.
  netAmount Int         @default(0)
  provider  String?
  providerRef String?
  createdAt DateTime    @default(now())
  paidAt    DateTime?
  refundedAt DateTime?

  /// Écritures de commission (lot 4). Immuables : une annulation crée une contre-écriture.
  ledger CommissionEntry[]

  @@index([userId])
  @@index([status, paidAt])
}

// ---- Lot 4 : commissions et registre d'écritures ----------------------------------------------

/// Bénéficiaire d'une écriture : l'écrivain (auteur de l'œuvre), le diocèse de l'acheteur, ou la plateforme.
enum LedgerParty {
  WRITER
  DIOCESE
  PLATFORM
}

/// Nature d'une écriture. Le registre ne se modifie pas : toute correction est une nouvelle écriture.
enum LedgerKind {
  SALE // vente encaissée : part due au bénéficiaire
  REFUND // remboursement : contre-écriture négative
  PAYOUT // versement effectué (débit du solde)
  ADJUSTMENT // correction manuelle motivée
}

/// Registre des commissions, écriture par écriture (section 12 du cahier des charges).
model CommissionEntry {
  id String @id @default(cuid())
  /// Clé d'idempotence : « sale:<orderId>:writer », « refund:<orderId>:diocese »… Un double
  /// encaissement ne peut donc pas produire deux fois la même commission.
  key      String     @unique
  kind     LedgerKind
  party    LedgerParty
  orderId  String?
  order    Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  /// Écrivain bénéficiaire. Null pour un diocèse ou la plateforme.
  beneficiaryUserId String?
  beneficiaryUser   User?   @relation("LedgerUser", fields: [beneficiaryUserId], references: [id], onDelete: SetNull)
  /// Diocèse bénéficiaire. Null pour un écrivain ou la plateforme.
  dioceseId String?
  diocese   Diocese? @relation("LedgerDiocese", fields: [dioceseId], references: [id], onDelete: SetNull)
  currency  String
  /// Montant signé, en plus petite unité : positif = dû au bénéficiaire, négatif = contre-écriture.
  amount    Int
  /// Taux retenu, en points de base (7000 = 70 %), pour pouvoir expliquer un calcul des mois après.
  ratePpm   Int     @default(0)
  note      String?
  createdAt DateTime @default(now())

  @@index([party, beneficiaryUserId, currency, createdAt])
  @@index([party, dioceseId, currency, createdAt])
  @@index([orderId])
  @@index([createdAt])
}

// ---- Lot 5 : versements (relevés, lots, approbation, référence) --------------------------------

enum PayoutStatus {
  DRAFT // préparé, encore modifiable
  APPROVED // validé par un responsable
  PAID // versé, avec référence de paiement
  CANCELED // annulé : les montants réservés repartent dans le solde
}

/// Lot de versement : un bénéficiaire type (écrivains ou diocèses) sur une période.
model PayoutBatch {
  id          String       @id @default(cuid())
  /// Référence lisible unique, ex. « VRS-2026-11-ECR-001 ».
  reference   String       @unique
  party       LedgerParty
  periodStart DateTime
  periodEnd   DateTime
  status      PayoutStatus @default(DRAFT)
  currency    String
  total       Int          @default(0)
  createdById String?
  approvedById String?
  approvedAt  DateTime?
  paidAt      DateTime?
  /// Référence du versement réel (numéro de transaction mobile money, bordereau…).
  paymentRef  String?
  note        String?
  createdAt   DateTime     @default(now())

  items PayoutItem[]

  @@index([party, status, periodEnd])
  @@index([status, createdAt])
}

model PayoutItem {
  id      String      @id @default(cuid())
  batchId String
  batch   PayoutBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  party   LedgerParty

  beneficiaryUserId String?
  beneficiaryUser   User?   @relation("PayoutUser", fields: [beneficiaryUserId], references: [id], onDelete: SetNull)
  dioceseId         String?
  diocese           Diocese? @relation("PayoutDiocese", fields: [dioceseId], references: [id], onDelete: SetNull)

  amount Int
  /// Solde du bénéficiaire au moment de la préparation, pour justifier le montant.
  balanceBefore Int
  createdAt DateTime @default(now())

  @@index([batchId])
  @@index([beneficiaryUserId])
  @@index([dioceseId])
}

// ---- Lot 6 : espace écrivain -------------------------------------------------------------------

enum WriterStatus {
  PENDING // profil soumis, pas encore validé par l'administration
  APPROVED
  REJECTED
}

/// Profil d'auteur/réalisateur : validation éditoriale et coordonnées de versement.
model WriterProfile {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  penName String?
  bio     String?
  status  WriterStatus @default(PENDING)
  /// Mobile money : réseau (MTN, Moov, Wave…) et numéro qui reçoit les versements.
  payoutNetwork String?
  payoutPhone   String?
  note          String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---- Lot 7 : dépôt de manuscrit (option) --------------------------------------------------------

enum ManuscriptStatus {
  SUBMITTED
  REVIEWING
  ACCEPTED
  REJECTED
}

/// Manuscrit proposé par un auteur : titre, résumé et lien vers le fichier (pas d'envoi de fichier
/// binaire : l'hébergement de démonstration n'a pas de disque inscriptible).
model Manuscript {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation("ManuscriptAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  language  String   @default("fr")
  synopsis  String?
  fileUrl   String?
  status    ManuscriptStatus @default(SUBMITTED)
  reviewerNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId, createdAt])
  @@index([status, createdAt])
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id])
  plan      Plan
  status    SubscriptionStatus @default(ACTIVE)
  startsAt  DateTime           @default(now())
  endsAt    DateTime
  renewsAt  DateTime?
  provider  String?

  @@index([userId, status])
}

model Progress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workId    String
  work      Work     @relation(fields: [workId], references: [id])
  position  Float // page ou seconde
  locator   String? // repère exact de lecture (EPUB : CFI)
  updatedAt DateTime @updatedAt

  @@unique([userId, workId])
}

model Favorite {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workId String
  work   Work   @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@id([userId, workId])
}

// Signet de lecture (section 9, L-06) : une position précise dans un livre
model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workId    String
  work      Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  locator   String // repère exact (EPUB : CFI)
  label     String?
  percent   Float    @default(0)
  createdAt DateTime @default(now())

  @@unique([userId, workId, locator])
  @@index([userId, workId])
}

// Prix des abonnements par pays (section 11) ; le montant est dans la plus petite unité de la devise
model PlanPrice {
  id       String @id @default(cuid())
  plan     Plan
  country  String
  currency String
  amount   Int

  @@unique([plan, country])
}

// Emplacements publicitaires (bandeaux). Les publicités sont gérées dans l'administration.
enum AdPlacement {
  HOME // bandeau de la page d'accueil
  CATALOG // bandeau des pages Livres, Documentaires et Films
  WORK // bandeau de la fiche d'une œuvre
  STICKY // bandeau fixe en bas de l'écran, que l'on peut fermer
  INTERSTITIAL // plein écran, pendant la lecture ou le visionnage d'un contenu gratuit
}

model Ad {
  id         String      @id @default(cuid())
  placement  AdPlacement
  title      String
  advertiser String
  text       String?
  imageUrl   String?
  linkUrl    String
  active     Boolean     @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  clicks     Int         @default(0)
  /// Nombre de fois où la publicité a été affichée. Un même visiteur n'est compté qu'une fois par séance.
  impressions Int        @default(0)
  createdAt  DateTime    @default(now())

  stats AdDailyStat[]

  @@index([placement, active])
}

/// Statistiques jour par jour, pour facturer un annonceur au mois sans garder une ligne par affichage.
model AdDailyStat {
  id          String   @id @default(cuid())
  adId        String
  ad          Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  /// Jour calendaire en UTC (heure serveur), pas l'horodatage de l'affichage.
  day         DateTime @db.Date
  impressions Int      @default(0)
  clicks      Int      @default(0)

  @@unique([adId, day])
  @@index([day])
}

// Journal d'audit (sections 4.3 et 16)
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Avis et commentaires. Publication immédiate (réponse client) : la modération est a posteriori,
// déclenchée par un signalement ou par la file d'administration.
enum ContentStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

enum ReportTarget {
  REVIEW
  COMMENT
}

enum ReportStatus {
  OPEN
  HANDLED
  DISMISSED
}

// Un avis par personne et par œuvre, note obligatoire de 1 à 5.
model Review {
  id        String        @id @default(cuid())
  workId    String
  work      Work          @relation(fields: [workId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  body      String?
  status    ContentStatus @default(PUBLISHED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([userId, workId])
  @@index([workId, status])
}

model Comment {
  id        String        @id @default(cuid())
  workId    String
  work      Work          @relation(fields: [workId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  status    ContentStatus @default(PUBLISHED)
  /// Réponse à un autre commentaire : un seul niveau, pas d'arborescence profonde.
  parentId  String?
  parent    Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]     @relation("CommentReplies")
  createdAt DateTime      @default(now())

  @@index([workId, status, createdAt])
}

// Signalement d'un avis ou d'un commentaire. La cible est polymorphe (pas de clé étrangère possible).
model Report {
  id         String       @id @default(cuid())
  targetType ReportTarget
  targetId   String
  reporterId String
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())

  @@unique([targetType, targetId, reporterId])
  @@index([status, createdAt])
}

// ---- Lot 8 : codes de partenariat et événements en direct ------------------------------------

enum PartnerKind {
  WRITER
  DIOCESE
}

enum LiveProvider {
  EMBED
  MUX
}

enum LiveStatus {
  DRAFT
  SCHEDULED
  LIVE
  ENDED
  ARCHIVED
}

enum LiveVisibility {
  PUBLIC
  AUTHENTICATED
  SUBSCRIBERS
}

/// Code remis au partenaire après signature du contrat. Le code en clair n'est JAMAIS stocké :
/// seul un HMAC-SHA256 (clé = SESSION_SECRET) est conservé, ce qui permet de le retrouver et
/// de le vérifier sans pouvoir le reconstituer depuis la base.
model PartnerCode {
  id           String      @id @default(cuid())
  codeHash     String      @unique
  label        String
  kind         PartnerKind
  contractRef  String?
  dioceseId    String?
  diocese      Diocese?    @relation(fields: [dioceseId], references: [id], onDelete: SetNull)
  expiresAt    DateTime
  usedAt       DateTime?
  usedByUserId String?
  usedBy       User?       @relation("PartnerCodeUsedBy", fields: [usedByUserId], references: [id], onDelete: SetNull)
  createdById  String?
  createdBy    User?       @relation("PartnerCodeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  revokedAt    DateTime?
  createdAt    DateTime    @default(now())

  @@index([kind, usedAt])
}

/// Badge délivré par l'administration : seul un porteur actif peut être désigné diffuseur d'un live.
model LiveBroadcaster {
  userId      String    @id
  user        User      @relation("LiveBadgeOwner", fields: [userId], references: [id], onDelete: Cascade)
  grantedById String?
  grantedBy   User?     @relation("LiveBadgeGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  note        String?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  events LiveEvent[] @relation("LiveBroadcasterEvents")
}

/// Paramètres applicatifs modifiables à chaud depuis la console d'administration.
/// Les secrets et les choix d'infrastructure (clés API, base, prestataires) restent des
/// variables d'environnement : ils ne doivent jamais être éditables depuis l'interface.
/// Chaque modification est en plus tracée dans AuditLog (action "setting.update").
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

/// Événement diffusé en direct. Le flux lui-même vient d'un prestataire externe (embed ou Mux HLS).
model LiveEvent {
  id            String         @id @default(cuid())
  slug          String         @unique
  title         String
  description   String?
  provider      LiveProvider   @default(EMBED)
  embedUrl      String?
  playbackId    String?
  replayUrl     String?
  status        LiveStatus     @default(DRAFT)
  visibility    LiveVisibility @default(PUBLIC)
  startsAt      DateTime
  endsAt        DateTime?
  broadcasterId String?
  broadcaster   LiveBroadcaster? @relation("LiveBroadcasterEvents", fields: [broadcasterId], references: [userId], onDelete: SetNull)
  createdById   String?
  createdBy     User?          @relation("LiveEventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status, startsAt])
}
