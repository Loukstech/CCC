{
  "name": "plateforme",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "prisma generate && node scripts/make-demo-epub.mjs && next build",
    "start": "next start -p 3200",
    "lint": "eslint",
    "db:seed": "tsx prisma/seed.ts",
    "db:dioceses": "tsx prisma/seed-dioceses.ts",
    "db:comptes": "tsx prisma/seed-comptes.ts",
    "db:covers": "tsx prisma/demo-covers.ts",
    "db:client-books": "node scripts/seed-client-books.mjs",
    "db:subtitles": "node scripts/seed-subtitles.mjs",
    "db:ads": "node scripts/seed-ads.mjs",
    "logos": "node scripts/build-logos.mjs",
    "admin:password": "tsx scripts/set-admin-password.ts",
    "demo:epub": "node scripts/make-demo-epub.mjs",
    "demo:videos": "node scripts/make-demo-videos.mjs",
    "db:migrate": "prisma migrate dev",
    "db:up": "docker compose up -d",
    "predev": "prisma generate"
  },
  "dependencies": {
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.9",
    "epubjs": "^0.3.93",
    "hls.js": "^1.7.4",
    "jose": "^6.2.14",
    "jszip": "^3.10.2",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
